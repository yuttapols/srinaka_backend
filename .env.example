JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200
DB_URL=jdbc:postgresql://localhost:5432/srinaka
DB_USERNAME=postgres
DB_PASSWORD=postgres
LOGIN_LOG_RETENTION_DAYS=90
ADMIN_SEED_USERNAME=admin
# Required — the app fails to start (if no ADMIN account exists yet) unless this is set. Never commit a real value.
ADMIN_SEED_PASSWORD=
# Required from Phase 2 onward (service/product images) — format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Required from Phase 2 onward (Customer login/register) — from LINE Developers Console, "LINE Login" channel
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# redirectUri is sent per-request by the frontend (must match the LINE channel's registered Callback URL),
# not read from env by the backend — this is just a reminder of what to register in LINE Developers Console.
